                "Literal": {
                  "Value": "'*{box-sizing:border-box;margin:0;padding:0}\nbody{background:transparent;font-family:''Segoe UI'',system-ui,sans-serif;overflow:hidden}\n.sqlmeta{display:flex;align-items:center;gap:8px;margin-bottom:8px}\n.sqlmeta span{font-size:10.5px;color:#5B6672;background:#F6F8FA;border:1px solid #E3E8EF;\n  border-radius:999px;padding:2px 10px;white-space:nowrap}\n.copybtn{cursor:pointer;font-family:''Segoe UI Semibold'',system-ui,sans-serif;font-size:10.5px;\n  color:#2563EB;background:#FFFFFF;border:1.5px solid #2563EB;border-radius:999px;padding:3px 14px;\n  white-space:nowrap;-webkit-user-select:none;user-select:none;transition:background .15s ease,color .15s ease,border-color .15s ease}\n.copybtn:hover{background:#EFF4FF}\n.copybtn:active{transform:scale(0.97)}\n.copybtn.copied{background:#059669;border-color:#059669;color:#FFFFFF}\n.copybtn.copyfail{background:#DC2626;border-color:#DC2626;color:#FFFFFF}\npre.sql{height:322px;\n  font-family:''Cascadia Mono'',''Consolas'',''Courier New'',monospace;font-size:11.5px;line-height:1.55;\n  color:#111827;background:#FBFCFD;border:1px solid #E3E8EF;border-radius:10px;padding:12px 14px;\n  white-space:pre-wrap;overflow-wrap:anywhere;tab-size:2;overflow:auto;\n  -webkit-user-select:text;user-select:text}\npre.sql::-webkit-scrollbar{width:10px}\npre.sql::-webkit-scrollbar-thumb{background:#CFD8E3;border-radius:999px;border:3px solid #FBFCFD}\n.sqltrunc{margin-top:7px;font-size:11px;color:#8A5B00;background:#FFF7E6;border:1px solid #F0DCB0;\n  border-radius:8px;padding:5px 10px}\n.sqlempty{font-size:12px;color:#5B6672;padding:14px 2px}'"
