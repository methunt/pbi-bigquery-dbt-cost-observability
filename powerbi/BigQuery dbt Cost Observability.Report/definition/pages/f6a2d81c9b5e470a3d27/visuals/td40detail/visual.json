            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'One row per model or test execution that did not come out clean, and the dbt invocation it happened in. Skipped means dbt did not run it in THAT invocation because something upstream failed — the same node may have built fine in a later run, which is what the invocation column is for. A skipped row has no message, no finish time and no cost, because it never reached BigQuery.'"
                }
              }
            },
            "fontFamily": {
              "expr": {
                "Literal": {
                  "Value": "'Segoe UI'"
                }
              }
            },
            "fontSize": {
              "expr": {
