/// Which source every table reads. "SampleCSV" reads the committed synthetic CSVs in sample-data/, so the report opens and refreshes with no Google Cloud access at all. "BigQuery" reads INFORMATION_SCHEMA.JOBS_BY_PROJECT and the dbt_artifacts tables live. Every fact and dbt table honours this one value, so a single change switches the whole model.
expression p_DataSource = "SampleCSV" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	lineageTag: 8f1c4d20-6ba7-4e93-9d51-3c07a5e21b44

	annotation PBI_ResultType = Text

/// Folder holding the sample CSVs. Used only when p_DataSource is "SampleCSV" - point it at the sample-data folder of your clone. A trailing slash or backslash is optional.
expression p_SampleDataPath = "D:\Git\PowerBi\Bigquery & Dbt Cost Observability\sample-data" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	lineageTag: 2a7e93b5-0c48-4f61-8ad2-71b9e6c0538f

	annotation PBI_ResultType = Text

/// Reads one sample CSV and applies the column types the model expects. Types are passed in per table rather than inferred, because CSV carries none: an inferred load hands every column back as text, which silently breaks the relationships and every numeric measure. Kept as one shared function so the CSV mechanics live in a single place and each partition only states its own type list.
expression fn_ReadSampleCsv =
		let
		    ReadCsv = (fileName as text, columnTypes as list) as table =>
		        let
		            _base =
		                if Text.EndsWith(p_SampleDataPath, "\") or Text.EndsWith(p_SampleDataPath, "/")
		                then p_SampleDataPath
		                else p_SampleDataPath & "\",
		            Source = Csv.Document(
		                File.Contents(_base & fileName),
		                [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
		            ),
		            Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
		            // An empty CSV field reads as an empty string, but BigQuery returns
		            // NULL - and the two are not interchangeable in DAX. ISBLANK("") is
		            // FALSE, so measures written as ISBLANK(Fact[parent_job_id]) match no
		            // rows at all and silently return blank. Normalise to null first so the
		            // CSV path carries the same semantics as the BigQuery path.
		            Nulled = Table.ReplaceValue(
		                Promoted, "", null, Replacer.ReplaceValue, Table.ColumnNames(Promoted)
		            ),
		            Typed = Table.TransformColumnTypes(Nulled, columnTypes)
		        in
		            Typed
		in
		    ReadCsv
	lineageTag: c5b81f47-92d3-4a06-b7e8-1d64f0a93c2e

	annotation PBI_ResultType = Function

	annotation PBI_NavigationStepName = Navigation

