/// BQ Job Details Fact Table
expression fx_GetJobdetails =
		(region as text, sqlTemplate as text) =>
		let
		    // Build table reference dynamically
		    tableName = "`region-" & region & "`.INFORMATION_SCHEMA.JOBS_BY_PROJECT",
		
		    // Replace placeholder in SQL
		    finalSql = Text.Replace(sqlTemplate, "__TABLE__", tableName),
		    finalSql2 = Text.Replace(finalSql, "__REGION__", region),
		
		    Result =
		        Value.NativeQuery(
		            Source_BQ{[Name = bq_project, Kind = "Database"]}[Data],
		            finalSql2,
		            null,
		            [EnableFolding = true]
		        )
		in
		    Result
	lineageTag: e0e83881-5ba3-4a36-9ed7-99d0b140aec0

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Function

