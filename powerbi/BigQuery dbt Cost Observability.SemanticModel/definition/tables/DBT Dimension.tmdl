				    ("Materialization", NAMEOF('dbt_models'[materialization]), 4),
				    ("Package", NAMEOF('dbt_models'[package_name]), 5),
				    ("Tag", NAMEOF('dbt_model_tags'[tag]), 6),
				    ("Runtime Band", NAMEOF('dbt_node_executions'[runtime_bucket]), 7),
				    ("Node Status", NAMEOF('dbt_node_executions'[status]), 8),
				    ("Target Table", NAMEOF('Fact'[destination_table_id]), 9),
				    ("Statement Type", NAMEOF('Fact'[statement_type]), 10),
				    ("Resource Type", NAMEOF('Fact'[label_resource_type]), 11),
				    ("Environment", NAMEOF('Fact'[label_env]), 12),
				    ("Region", NAMEOF('Fact'[region]), 13),
				    ("User", NAMEOF('Fact'[user_email]), 14),
