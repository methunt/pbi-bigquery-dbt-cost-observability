table 'DBT Dimension'
	lineageTag: 1031be23-265b-4250-ab8e-e5fa97ee767e

	/// The dimension name a user picks in the Explore slicer. Selecting one re-points every dimension-driven visual on the page at that field, so a single grid can slice dbt spend by model, layer, target table, environment, user or run.
	column 'DBT Dimension'
		lineageTag: 7716c829-1f44-4d3c-b879-3a3421097658
		summarizeBy: none
		sourceColumn: [Value1]
		sortByColumn: 'DBT Dimension Order'

		relatedColumnDetails
			groupByColumn: 'DBT Dimension Fields'

		annotation SummarizationSetBy = Automatic

	/// The underlying field each choice maps to. Internal plumbing for the field parameter - not for report use.
	column 'DBT Dimension Fields'
		isHidden
		lineageTag: e9662d92-289c-42d4-8cb4-12f732691a88
		summarizeBy: none
		sourceColumn: [Value2]
		sortByColumn: 'DBT Dimension Order'

		extendedProperty ParameterMetadata =
				{
				  "version": 3,
				  "kind": 2
				}

		annotation SummarizationSetBy = Automatic

	/// Display order of the choices, and the stable key to switch on in DAX. Use this rather than the display column, which is part of a composite key and cannot be read with SELECTEDVALUE.
	column 'DBT Dimension Order'
		isHidden
		formatString: 0
		lineageTag: 5cccf410-af4b-49cc-bfc0-1c068ec4792c
		summarizeBy: sum
		sourceColumn: [Value3]

		annotation SummarizationSetBy = Automatic

	partition 'DBT Dimension' = calculated
